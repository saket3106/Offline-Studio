{
  "name": "offline-gpt-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:mock": "vite --host 127.0.0.1 --open /?mock",
    "test": "node --test src/*.test.js",
    "lint": "eslint src scripts && node scripts/lint.mjs",
    "test:qt": "echo Run tests/qt_ui_upgrade.py with the retained SDK Python and an isolated output path",
    "test:unit": "vitest run --config vitest.config.js",
    "test:browser": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "format:check": "prettier --check src/uiLogic.js src/dataAccess.js src/uiState.js src/upgrade.jsx src/controls.jsx src/UIKit.jsx src/mockAdapter.js src/tokens.css src/upgrade.css scripts/*.mjs *.config.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0-alpha.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "9.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.0.6",
    "vite": "^6.1.0",
    "vitest": "3.2.4"
  },
  "browserslist": [
    "Chrome >= 140"
  ]
}
